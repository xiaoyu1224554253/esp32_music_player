{
  "name": "ESP32 Music Player (ESP-IDF)",
  "image": "espressif/idf:release-v6.0",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "espressif.esp-idf-extension"
      ],
      "settings": {
        "idf.espIdfPath": "/opt/espressif/esp-idf"
      }
    }
  },
  "remoteEnv": {
    "IDF_TARGET": "esp32s3"
  },
  "postCreateCommand": "echo 'ESP-IDF dev container ready. Run: . $IDF_PATH/export.sh && idf.py build'"
}
